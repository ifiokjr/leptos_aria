  "changesets": [
    {
      "path": ".changeset/browser-accessibility.md",
      "summary": "Browser accessibility regression coverage",
      "details": "Production demos and documentation now run through Playwright in Chromium, Firefox, WebKit, dark mode, and a mobile viewport, with WCAG audits and keyboard journeys required by CI. Space activation no longer panics when the press ends on a document listener. Tooltips retain working event handlers, describe their focused control, dismiss on Escape, and cancel stale hover opens. Accordions link their triggers and panels; selects link their combobox and listbox; menus expose menu/menuitem semantics through the new `ListBoxRole` prop instead of nested listbox roles. Radio navigation wraps in WebKit and skips disabled options. Decorative separators and modal backdrops omit unsupported ARIA, destructive examples keep sufficient text contrast, and scrollable documentation code, install commands, and tables are keyboard reachable.",
      "targets": [
        {
          "id": "main",
          "kind": "group",
          "bump": "minor",
          "origin": "direct-change",
          "evidence_refs": [],
          "change_type": "minor"
        }
      ],
